{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "example": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "ats",

      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig-ui.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/langs",
              "src/img"
            ],
            "styles": [
              "src/app/css/index.less",
              "src/app/css/popup-items.less",
              "src/lib/mapbox-gl/mapbox-gl.css",
              "src/lib/leaflet/leaflet.css"
            ],
            "scripts": [],
            "aot": false,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization":  {
              "scripts": false,
              "styles": false
            },
            "namedChunks": true,
            "browser": "src/app/init.ts"
          },
          "configurations": {
            "hmr": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hmr.ts"
                }
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "baseHref": "/bike-atlas/",
              "deployUrl": "http://206.189.114.217:8080/",
              "optimization": true,
              "outputHashing": "none",
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.js",
            "buildTarget": "example:build"

          },
          "configurations": {
            "production": {
              "buildTarget": "example:build:production"
            },
            "hmr": {
              "hmr": true,
              "buildTarget": "example:build:hmr"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "example:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "29099972-295a-4c48-ab93-04016830cdcd"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
